{
  "name": "sifen-sandbox",
  "version": "0.1.0",
  "description": "Simulador local de SIFEN (facturación electrónica de Paraguay) para probar integraciones sin certificado ni habilitación.",
  "license": "MIT",
  "author": "Marcos Arellano",
  "type": "module",
  "bin": {
    "sifen-sandbox": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts/download-xsd.mjs",
    "schemas.lock.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "xsd:download": "node scripts/download-xsd.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.8",
    "fflate": "^0.8.2",
    "xml-crypto": "^6.1.2",
    "xmllint-wasm": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/node-forge": "^1.3.11",
    "node-forge": "^1.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
